{
  "$defs": {
    "CostPolicy": {
      "additionalProperties": false,
      "properties": {
        "commission_per_order": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "default": "1",
          "title": "Commission Per Order"
        },
        "slippage_bps": {
          "anyOf": [
            {
              "maximum": 1000.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "default": "5",
          "title": "Slippage Bps"
        },
        "spread_bps": {
          "anyOf": [
            {
              "maximum": 1000.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Spread Bps"
        },
        "version": {
          "const": "quant-cost-v1",
          "default": "quant-cost-v1",
          "title": "Version",
          "type": "string"
        }
      },
      "title": "CostPolicy",
      "type": "object"
    },
    "ExperimentVariant": {
      "additionalProperties": false,
      "properties": {
        "costs": {
          "$ref": "#/$defs/CostPolicy"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "policy": {
          "$ref": "#/$defs/QuantPolicy"
        },
        "purpose": {
          "title": "Purpose",
          "type": "string"
        },
        "strategy": {
          "enum": [
            "CASH",
            "SPY_BUY_HOLD",
            "EQUAL_WEIGHT",
            "A0",
            "A1",
            "A2",
            "A3",
            "A4"
          ],
          "title": "Strategy",
          "type": "string"
        }
      },
      "required": [
        "name",
        "strategy",
        "policy",
        "costs",
        "purpose"
      ],
      "title": "ExperimentVariant",
      "type": "object"
    },
    "QuantPolicy": {
      "additionalProperties": false,
      "properties": {
        "allocation": {
          "default": "risk_adjusted",
          "enum": [
            "score",
            "inverse_volatility",
            "risk_adjusted"
          ],
          "title": "Allocation",
          "type": "string"
        },
        "approval_reference": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Approval Reference"
        },
        "correlation_limit": {
          "anyOf": [
            {
              "exclusiveMinimum": 0.0,
              "maximum": 1.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Correlation Limit"
        },
        "correlation_lookback": {
          "default": 60,
          "minimum": 20,
          "title": "Correlation Lookback",
          "type": "integer"
        },
        "cross_section_minimum": {
          "default": 5,
          "minimum": 3,
          "title": "Cross Section Minimum",
          "type": "integer"
        },
        "downtrend_multiplier": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "default": "0.25",
          "title": "Downtrend Multiplier"
        },
        "high_volatility_absolute": {
          "anyOf": [
            {
              "exclusiveMinimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "default": "0.25",
          "title": "High Volatility Absolute"
        },
        "high_volatility_multiplier": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "default": "0.5",
          "title": "High Volatility Multiplier"
        },
        "high_volatility_percentile": {
          "anyOf": [
            {
              "exclusiveMinimum": 0.0,
              "maximum": 1.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "default": "0.80",
          "title": "High Volatility Percentile"
        },
        "max_turnover": {
          "anyOf": [
            {
              "exclusiveMinimum": 0.0,
              "maximum": 2.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "default": "0.20",
          "title": "Max Turnover"
        },
        "max_volume_participation": {
          "anyOf": [
            {
              "exclusiveMinimum": 0.0,
              "maximum": 1.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "default": "0.01",
          "title": "Max Volume Participation"
        },
        "minimum_benefit_cost_ratio": {
          "anyOf": [
            {
              "minimum": 1.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "default": "1.5",
          "title": "Minimum Benefit Cost Ratio"
        },
        "minimum_dollar_volume": {
          "anyOf": [
            {
              "exclusiveMinimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "default": "1000000",
          "title": "Minimum Dollar Volume"
        },
        "minimum_oos_folds": {
          "default": 2,
          "minimum": 2,
          "title": "Minimum Oos Folds",
          "type": "integer"
        },
        "minimum_oos_sessions": {
          "default": 252,
          "minimum": 252,
          "title": "Minimum Oos Sessions",
          "type": "integer"
        },
        "minimum_trade_notional": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "default": "100",
          "title": "Minimum Trade Notional"
        },
        "mode": {
          "default": "QUANT_V1_BASELINE",
          "enum": [
            "QUANT_V1_BASELINE",
            "QUANT_V2_SHADOW",
            "QUANT_V2_PAPER_CANDIDATE"
          ],
          "title": "Mode",
          "type": "string"
        },
        "momentum_scale": {
          "anyOf": [
            {
              "exclusiveMinimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "default": "0.10",
          "title": "Momentum Scale"
        },
        "momentum_weight": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "default": "0.7",
          "title": "Momentum Weight"
        },
        "no_trade_band": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "default": "0.01",
          "title": "No Trade Band"
        },
        "paper_approved": {
          "default": false,
          "title": "Paper Approved",
          "type": "boolean"
        },
        "rebalance": {
          "default": "threshold",
          "enum": [
            "daily",
            "weekly",
            "threshold"
          ],
          "title": "Rebalance",
          "type": "string"
        },
        "rebalance_threshold": {
          "anyOf": [
            {
              "maximum": 2.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "default": "0.02",
          "title": "Rebalance Threshold"
        },
        "regime_trend_band": {
          "anyOf": [
            {
              "exclusiveMinimum": 0.0,
              "maximum": 1.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "default": "0.02",
          "title": "Regime Trend Band"
        },
        "risk_off_drawdown": {
          "anyOf": [
            {
              "exclusiveMaximum": 0.0,
              "exclusiveMinimum": -1.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "default": "-0.15",
          "title": "Risk Off Drawdown"
        },
        "strategy": {
          "default": "A4",
          "enum": [
            "A0",
            "A1",
            "A2",
            "A3",
            "A4"
          ],
          "title": "Strategy",
          "type": "string"
        },
        "target_volatility": {
          "anyOf": [
            {
              "exclusiveMinimum": 0.0,
              "maximum": 1.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "default": "0.15",
          "title": "Target Volatility"
        },
        "trend_scale": {
          "anyOf": [
            {
              "exclusiveMinimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "default": "0.05",
          "title": "Trend Scale"
        },
        "trend_weight": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "default": "0.3",
          "title": "Trend Weight"
        },
        "use_cost_gate": {
          "default": true,
          "title": "Use Cost Gate",
          "type": "boolean"
        },
        "use_momentum": {
          "default": true,
          "title": "Use Momentum",
          "type": "boolean"
        },
        "use_trend": {
          "default": true,
          "title": "Use Trend",
          "type": "boolean"
        },
        "use_volatility_adjustment": {
          "default": true,
          "title": "Use Volatility Adjustment",
          "type": "boolean"
        },
        "version": {
          "const": "quant-v2.1",
          "default": "quant-v2.1",
          "title": "Version",
          "type": "string"
        },
        "volatility_floor": {
          "anyOf": [
            {
              "exclusiveMinimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "default": "0.05",
          "title": "Volatility Floor"
        }
      },
      "title": "QuantPolicy",
      "type": "object"
    },
    "RiskPolicy": {
      "additionalProperties": false,
      "properties": {
        "allow_leverage": {
          "default": false,
          "title": "Allow Leverage",
          "type": "boolean"
        },
        "example_defaults": {
          "default": true,
          "title": "Example Defaults",
          "type": "boolean"
        },
        "long_only": {
          "default": true,
          "title": "Long Only",
          "type": "boolean"
        },
        "max_daily_turnover": {
          "anyOf": [
            {
              "exclusiveMinimum": 0.0,
              "maximum": 2.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Max Daily Turnover"
        },
        "max_number_positions": {
          "maximum": 500,
          "minimum": 1,
          "title": "Max Number Positions",
          "type": "integer"
        },
        "max_position_weight": {
          "anyOf": [
            {
              "exclusiveMinimum": 0.0,
              "maximum": 1.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Max Position Weight"
        },
        "max_sector_weight": {
          "anyOf": [
            {
              "exclusiveMinimum": 0.0,
              "maximum": 1.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Max Sector Weight"
        },
        "max_single_order_nav_percent": {
          "anyOf": [
            {
              "exclusiveMinimum": 0.0,
              "maximum": 1.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Max Single Order Nav Percent"
        },
        "min_cash_weight": {
          "anyOf": [
            {
              "exclusiveMaximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Min Cash Weight"
        }
      },
      "required": [
        "max_position_weight",
        "max_sector_weight",
        "min_cash_weight",
        "max_daily_turnover",
        "max_single_order_nav_percent",
        "max_number_positions"
      ],
      "title": "RiskPolicy",
      "type": "object"
    },
    "WalkForwardFold": {
      "additionalProperties": false,
      "properties": {
        "embargo_sessions": {
          "default": 1,
          "minimum": 1,
          "title": "Embargo Sessions",
          "type": "integer"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "test_end": {
          "format": "date",
          "title": "Test End",
          "type": "string"
        },
        "test_start": {
          "format": "date",
          "title": "Test Start",
          "type": "string"
        },
        "train_end": {
          "format": "date",
          "title": "Train End",
          "type": "string"
        },
        "train_start": {
          "format": "date",
          "title": "Train Start",
          "type": "string"
        },
        "validation_end": {
          "format": "date",
          "title": "Validation End",
          "type": "string"
        },
        "validation_start": {
          "format": "date",
          "title": "Validation Start",
          "type": "string"
        }
      },
      "required": [
        "name",
        "train_start",
        "train_end",
        "validation_start",
        "validation_end",
        "test_start",
        "test_end"
      ],
      "title": "WalkForwardFold",
      "type": "object"
    }
  },
  "$id": "https://meridian-alpha.local/schemas/quant-v2-experiment-plan.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "declared_at": {
      "format": "date-time",
      "title": "Declared At",
      "type": "string"
    },
    "final_oos_tuning": {
      "const": false,
      "default": false,
      "title": "Final Oos Tuning",
      "type": "boolean"
    },
    "folds": {
      "items": {
        "$ref": "#/$defs/WalkForwardFold"
      },
      "title": "Folds",
      "type": "array"
    },
    "risk": {
      "$ref": "#/$defs/RiskPolicy"
    },
    "selection": {
      "const": "NONE_FIXED_PREDECLARED_MODELS",
      "default": "NONE_FIXED_PREDECLARED_MODELS",
      "title": "Selection",
      "type": "string"
    },
    "variants": {
      "items": {
        "$ref": "#/$defs/ExperimentVariant"
      },
      "title": "Variants",
      "type": "array"
    },
    "version": {
      "default": "quant-experiment-plan-v1",
      "title": "Version",
      "type": "string"
    }
  },
  "required": [
    "declared_at",
    "folds",
    "variants",
    "risk"
  ],
  "title": "ExperimentPlan",
  "type": "object"
}
