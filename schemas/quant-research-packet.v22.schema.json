            "type": "string"
          },
          "title": "Inclusion Reasons",
          "type": "array"
        },
        "exclusion_reasons": {
          "items": {
            "type": "string"
          },
          "title": "Exclusion Reasons",
          "type": "array"
        },
        "score_change": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
