        "as_of",
        "strategy",
        "policy_version",
        "quant_score",
        "relative_rank",
        "contributions",
        "data_quality_status",
        "completeness",
        "risk_multiplier",
        "risk_adjustments",
        "inclusion_reasons",
        "exclusion_reasons",
