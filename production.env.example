# Do not put real secrets in this repository.
MERIDIAN_ENV=production
# Inject a high-entropy bearer token through a secret manager at deployment.
MERIDIAN_MCP_BEARER_TOKEN=
MERIDIAN_LOG_FORMAT=json
# Optional Codex research overrides. Omit the model to inherit Codex's default.
MERIDIAN_CODEX_MODEL=
MERIDIAN_CODEX_REASONING_EFFORT=medium
MERIDIAN_CODEX_TIMEOUT_SECONDS=180
