{
  "version": "meridian-skill-workflows.v2",
  "authority": "ADVISORY_ONLY",
  "defaults": {
    "max_tool_calls": 6,
    "wall_seconds": 60,
    "nested_model_calls": 0,
    "missing_data": "UNKNOWN or WAIT_FOR_EVIDENCE; never invent an input or optimistic rank",
    "risk_checks": ["analysis cutoff and availability", "freshness and certification", "manual authority", "no inferred fills"],
    "output_schema": "meridian-decision-brief.v1",
    "prohibited_side_effects": ["broker access", "orders", "ledger/cache/database writes", "automatic promotion", "credential access", "external installation"]
  },
  "workflows": [
    {"intent": "DAILY_MARKET_OVERVIEW", "required_evidence": ["current sourced quotes", "SPY PIT history", "session clock"], "tools": ["runtime_status", "market_snapshot", "quant_research_snapshot"], "gpt_reasoning": "Explain measured regime and opposing risks; breadth remains unknown without qualified membership data"},
    {"intent": "COMPANY_QUANT_RESEARCH", "required_evidence": ["symbol and benchmark history", "factor provenance", "filing availability"], "tools": ["quant_research_snapshot", "research_evidence_trace", "company_facts"], "gpt_reasoning": "Explain economic hypotheses and observed factor contributions; score is not expected return"},
    {"intent": "EVENT_CATALYST", "required_evidence": ["dated primary event", "source identity", "current observation"], "tools": ["event_evidence", "company_facts", "market_snapshot"], "gpt_reasoning": "Separate reported event from its conditional interpretation; preserve contradictory events"},
    {"intent": "EARNINGS_REVIEW", "required_evidence": ["exact accession and acceptance", "comparable fiscal periods", "revision lineage"], "tools": ["company_facts", "research_packet"], "gpt_reasoning": "Explain revenue and profitability comparisons; missing forward estimates and valuation stay unknown"},
    {"intent": "QUANT_SHORTLIST", "required_evidence": ["same-cutoff universe history", "SPY benchmark", "factor eligibility"], "tools": ["quant_research_snapshot", "research_evidence_trace"], "gpt_reasoning": "Discuss deterministic ranks and exclusions; never replace rank with a model preference"},
    {"intent": "PORTFOLIO_REVIEW", "required_evidence": ["authorized current sanitized paper snapshot", "PIT metadata", "declared hypothetical weights"], "tools": ["account_snapshot", "portfolio_context", "risk_analysis", "portfolio_what_if"], "gpt_reasoning": "Explain cash and concentration changes; unknown correlations and ETF overlap remain unknown"},
    {"intent": "BUY_ADD_REVIEW", "required_evidence": ["fresh reference quote", "qualified factor history", "authorized account", "sourced catalyst"], "tools": ["market_snapshot", "quant_research_snapshot", "portfolio_what_if", "event_evidence"], "gpt_reasoning": "Compare buying with waiting and opposing evidence; no model price, quantity or approved order"},
    {"intent": "HOLD_SELL_REVIEW", "required_evidence": ["newly supplied holdings", "factor persistence", "thesis invalidation evidence"], "tools": ["account_snapshot", "quant_research_snapshot", "portfolio_what_if"], "gpt_reasoning": "Explain holding or trimming hypothetically; recommendations are never fills"},
    {"intent": "DIP_RESEARCH", "required_evidence": ["qualified adjusted history", "observed quote", "volatility/drawdown", "contrary catalyst evidence"], "tools": ["quant_research_snapshot", "market_snapshot", "event_evidence"], "gpt_reasoning": "Distinguish drawdown from intrinsic value; wait when deterministic entry inputs are missing"},
    {"intent": "RISK_PRE_MORTEM", "required_evidence": ["current authorized portfolio", "explicit bounded shocks", "known exposures"], "tools": ["portfolio_what_if", "risk_analysis", "event_evidence"], "gpt_reasoning": "Explain declared shock sensitivity and failure paths; shock is an assumption, not a model price forecast"},
    {"intent": "MARKET_REGIME_REVIEW", "required_evidence": ["qualified SPY history", "regime thresholds and hash"], "tools": ["quant_research_snapshot", "macro_context"], "gpt_reasoning": "Explain independently measured trend/volatility dimensions; risk reduction is not alpha"},
    {"intent": "FORWARD_RESULT_REVIEW", "required_evidence": ["matured reviewed closes", "inception and horizon provenance", "dependence eligibility"], "tools": ["forward_evidence", "audit_lookup"], "gpt_reasoning": "Interpret existing outcome eligibility; do not append outcomes or infer significance from overlapping observations"},
    {"intent": "BACKTEST_INTERPRETATION", "required_evidence": ["sealed experiment registry", "chronological partitions", "costs", "financial evidence class"], "tools": ["forward_evidence", "runtime_status"], "gpt_reasoning": "Read operator-supplied sealed Quant registry with meridian quant inspect; disclose missing MCP registry rather than invent a tool or performance"}
  ]
}
